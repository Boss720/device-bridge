{
  "name": "devicebridge",
  "version": "1.0.1",
  "description": "Seamless Windows app + phone companion for instant cross-device transfer of text, files, photos, videos, links, and pasted clipboard content",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "node server.js",
    "test": "node --test test/**/*.test.js",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.devicebridge.app",
    "productName": "DeviceBridge",
    "copyright": "Copyright © 2026 DeviceBridge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "DeviceBridge"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeviceBridge",
      "uninstallDisplayName": "DeviceBridge",
      "artifactName": "DeviceBridge-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "DeviceBridge-${version}-portable-x64.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Boss720",
      "repo": "device-bridge"
    }
  },
  "keywords": [
    "cross-device",
    "transfer",
    "clipboard",
    "photos",
    "videos",
    "files",
    "windows",
    "phone-companion"
  ],
  "author": "DeviceBridge",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
